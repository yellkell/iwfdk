 namespace device {
 
+namespace {
+
+XrResult SuggestProfileBindings(
+    XrInstance instance,
+    XrPath interaction_profile,
+    const std::vector<XrActionSuggestedBinding>& bindings) {
+  XrInteractionProfileSuggestedBinding profile_suggested_bindings = {
+      XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
+  profile_suggested_bindings.interactionProfile = interaction_profile;
+  profile_suggested_bindings.suggestedBindings = bindings.data();
+  profile_suggested_bindings.countSuggestedBindings = bindings.size();
+  return xrSuggestInteractionProfileBindings(instance,
+                                             &profile_suggested_bindings);
+}
+
+// Returns the subset of `bindings` whose component paths are in the Steam
+// Frame core set (see IsValveFrameCoreComponentPath()).
+std::vector<XrActionSuggestedBinding> GetValveFrameCoreBindings(
+    XrInstance instance,
+    const std::vector<XrActionSuggestedBinding>& bindings) {
+  static constexpr std::string_view kHandPrefixes[] = {"/user/hand/left",
+                                                       "/user/hand/right"};
+  std::vector<XrActionSuggestedBinding> core;
+  for (const XrActionSuggestedBinding& binding : bindings) {
+    uint32_t length = 0;
+    if (XR_FAILED(
+            xrPathToString(instance, binding.binding, 0, &length, nullptr)) ||
+        length == 0) {
+      continue;
+    }
+    std::string path(length, '\0');
+    if (XR_FAILED(xrPathToString(instance, binding.binding, length, &length,
+                                 path.data()))) {
+      continue;
+    }
+    path.resize(length - 1);  // Drop the terminator.
+    for (std::string_view prefix : kHandPrefixes) {
+      if (base::StartsWith(path, prefix) &&
+          IsValveFrameCoreComponentPath(
+              std::string_view(path).substr(prefix.size()))) {
+        core.push_back(binding);
+        break;
+      }
+    }
+  }
+  return core;
+}
+
+}  // namespace
