     controller_states_[i].squeeze_button_pressed = false;
   }
 
+  const XrPath valve_frame_profile = path_helper_->GetInteractionProfileXrPath(
+      mojom::OpenXrInteractionProfileType::kValveFrame);
   for (auto it = bindings.begin(); it != bindings.end(); it++) {
-    XrInteractionProfileSuggestedBinding profile_suggested_bindings = {
-        XR_TYPE_INTERACTION_PROFILE_SUGGESTED_BINDING};
-    profile_suggested_bindings.interactionProfile = it->first;
-    profile_suggested_bindings.suggestedBindings = it->second.data();
-    profile_suggested_bindings.countSuggestedBindings = it->second.size();
-
-    RETURN_IF_XR_FAILED(xrSuggestInteractionProfileBindings(
-        instance, &profile_suggested_bindings));
+    XrResult result = SuggestProfileBindings(instance, it->first, it->second);
+    if (it->first != valve_frame_profile) {
+      RETURN_IF_XR_FAILED(result);
+      continue;
+    }
+    // The Steam Frame profile is new; if a runtime rejects it, skip it so the
+    // runtime maps the controllers onto another suggested profile instead of
+    // input failing as a whole.
+    if (XR_FAILED(result)) {
+      DLOG(WARNING) << __func__ << ": Steam Frame bindings rejected (" << result
+                    << ")";
+    }
