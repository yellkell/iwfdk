new file mode 100644
index 00000000..b9f78c45
--- /dev/null
+++ b/device/vr/openxr/openxr_interaction_profiles_unittest.cc
@@ -0,0 +1,101 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "device/vr/openxr/openxr_interaction_profiles.h"
+
+#include <set>
+#include <string>
+
+#include "device/vr/openxr/openxr_interaction_profile_paths.h"
+#include "device/vr/public/mojom/openxr_interaction_profile_type.mojom.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace device {
+
+namespace {
+
+using mojom::OpenXrInteractionProfileType;
+
+const OpenXrControllerInteractionProfile* FindProfile(
+    OpenXrInteractionProfileType type) {
+  for (const auto& profile : GetOpenXrControllerInteractionProfiles()) {
+    if (profile.type == type) {
+      return &profile;
+    }
+  }
+  return nullptr;
+}
+
+std::set<std::string> ComponentPaths(
+    const std::vector<OpenXrButtonPathMap>& button_maps) {
+  std::set<std::string> paths;
+  for (const auto& button_map : button_maps) {
+    for (const auto& action_map : button_map.action_maps) {
+      paths.insert(action_map.path);
+    }
+  }
+  return paths;
+}
+
+}  // namespace
+
+TEST(OpenXrInteractionProfilesTest, ValveFrameProfile) {
+  const OpenXrControllerInteractionProfile* frame =
+      FindProfile(OpenXrInteractionProfileType::kValveFrame);
+  ASSERT_NE(frame, nullptr);
+  EXPECT_EQ(frame->path, kValveFrameInteractionProfilePath);
+
+  const auto& input_profiles =
+      GetOpenXrInputProfilesMap().at(OpenXrInteractionProfileType::kValveFrame);
+  ASSERT_EQ(input_profiles.size(), 1u);
+  EXPECT_EQ(input_profiles[0].input_profiles.front(), "valve-frame");
+
+  // The menu button must not be bound to kMenu, which exits the session.
+  for (const auto* maps : {&frame->common_button_maps, &frame->left_button_maps,
+                           &frame->right_button_maps}) {
+    for (const auto& button_map : *maps) {
+      EXPECT_NE(button_map.type, OpenXrButtonType::kMenu);
+    }
+  }
+}
+
+TEST(OpenXrInteractionProfilesTest, ValveFramePaths) {
+  const OpenXrControllerInteractionProfile* frame =
+      FindProfile(OpenXrInteractionProfileType::kValveFrame);
+  ASSERT_NE(frame, nullptr);
+  EXPECT_EQ(frame->required_extension,
+            kValveFrameControllerInteractionExtensionName);
+
+  const std::set<std::string> common =
+      ComponentPaths(frame->common_button_maps);
+  const std::set<std::string> left = ComponentPaths(frame->left_button_maps);
+  const std::set<std::string> right = ComponentPaths(frame->right_button_maps);
+
+  for (const char* path :
+       {"/input/trigger/click", "/input/trigger/value", "/input/trigger/touch",
+        "/input/squeeze/click", "/input/squeeze/value", "/input/squeeze/touch",
+        "/input/shoulder/click", "/input/shoulder/touch",
+        "/input/thumbstick/click", "/input/thumbstick/touch"}) {
+    EXPECT_TRUE(common.contains(path)) << path;
+  }
+  // Face buttons: A/B/X/Y and menu on the right, the D-pad and view on the
+  // left.
+  for (const char* path : {"/input/a/click", "/input/b/click", "/input/x/click",
+                           "/input/y/click", "/input/menu/click"}) {
+    EXPECT_TRUE(right.contains(path)) << path;
+    EXPECT_FALSE(left.contains(path)) << path;
+  }
+  for (const char* path : {"/input/dpad_up/click", "/input/dpad_down/click",
+                           "/input/dpad_left/click", "/input/dpad_right/click",
+                           "/input/view/click"}) {
+    EXPECT_TRUE(left.contains(path)) << path;
+    EXPECT_FALSE(right.contains(path)) << path;
+  }
+  // The system button is reserved by the runtime.
+  for (const auto* paths : {&common, &left, &right}) {
+    EXPECT_FALSE(paths->contains("/input/system/click"));
+  }
+}
+
+}  // namespace device
